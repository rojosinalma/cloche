# cloche configuration. Copy to .env: docker compose reads it for interpolation
# and mounts it into the container at /app/.env, where the app loads it (dotenv).
# Generate a token with: openssl rand -hex 32

# --- Secrets ---------------------------------------------------------------

# Bearer token for /api and /mcp. Empty = those endpoints answer 404 (fail closed).
CLOCHE_MCP_TOKEN=
# opencode server password for end-of-share callbacks (HTTP Basic). Empty = callbacks off.
OPENCODE_SERVER_PASSWORD=
# opencode server username for callbacks.
# OPENCODE_SERVER_USERNAME=opencode

# --- Structural ------------------------------------------------------------

# Host home directory (required). Host paths are mounted at the same absolute path in the container.
HOST_HOME=
# Host directory bind-mounted read-only into the container (default: HOST_HOME).
# CLOCHE_SHARE_ROOT=
# Host interface the published port binds to (0.0.0.0 to expose it on the LAN).
# CLOCHE_BIND=127.0.0.1
# Host port.
# CLOCHE_PORT=9292
# uid/gid the container runs as; ./data must be writable by it (0 = fix ownership, then drop to 1000).
# CLOCHE_UID=1000
# CLOCHE_GID=1000
# production, or development for live code reload.
# RACK_ENV=production
# Log level: debug, info, warn, error.
# LOG_LEVEL=info

# --- First-boot seeds ------------------------------------------------------
# Copied into the settings table only when the key does not exist yet;
# afterwards change them with the settings API (PUT /api/settings/:key) or MCP set_setting.

# Comma-separated absolute paths agents may share (default: HOST_HOME).
# CLOCHE_ROOTS=
# Base of the share URLs handed out.
# PUBLIC_BASE_URL=http://localhost:9292
# Second base, returned as lan_url (default: PUBLIC_BASE_URL).
# LAN_BASE_URL=
# opencode server that receives the callbacks.
# OPENCODE_URL=http://host.docker.internal:4096
