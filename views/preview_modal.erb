  <div class="preview" id="preview" hidden data-config="<%= JSON.generate(Preview.client_config(self)) %>">
    <div class="preview-bar">
      <%== icon("file-earmark", css: "preview-icon", id: "preview-icon") %>
      <span class="preview-name" id="preview-name"></span>
      <span class="t-badge" data-tone="accent" data-variant="outline" id="preview-badge" hidden></span>
      <span class="file-size"><span id="preview-size"></span><span id="preview-stats"></span></span>
      <span class="preview-count" id="preview-count"></span>
      <div class="t-cluster preview-tools">
        <div class="t-btn-group preview-tabs" data-role="filter" id="preview-tabs" role="group" aria-label="View" hidden></div>
        <div class="preview-viewer-tools" id="preview-viewer-tools"></div>
        <a class="t-btn" data-size="sm" data-icon="only" data-tone="success" id="preview-download" href="#" data-tip="Download" aria-label="Download"><%== icon("download") %></a>
        <button class="t-btn" data-size="sm" data-icon="only" type="button" id="preview-close" data-tip="Close (Esc)" aria-label="Close"><%== icon("x-lg") %></button>
      </div>
    </div>
    <button class="preview-nav preview-prev" id="preview-prev" data-tip="Previous (←)" aria-label="Previous"><%== icon("chevron-left") %></button>
    <div class="preview-stage" id="preview-stage"></div>
    <button class="preview-nav preview-next" id="preview-next" data-tip="Next (→)" aria-label="Next"><%== icon("chevron-right") %></button>
    <%# Shared states a viewer root shows instead of its own body (too large, could not load). %>
    <template id="preview-tpl-notice">
      <div class="preview-panel preview-notice">
        <div class="t-empty">
          <%== icon("file-earmark-x", css: "t-empty-icon") %>
          <span data-role="message"></span>
          <div class="t-empty-actions"><a class="t-btn preview-download-link" data-variant="primary" href="#"><%== icon("download") %>Download it instead</a></div>
        </div>
      </div>
    </template>
    <%# Per-viewer markup from views/viewers/<id>.erb: [data-slot=tools] goes into the bar, [data-slot=body] into the stage. %>
    <% Preview.templates(self).each do |id| -%>
    <template id="preview-tpl-<%= id %>"><%== render("viewers/#{id}") %></template>
    <% end -%>
  </div>

  <script type="importmap">
    { "imports": { "three": "https://cdn.jsdelivr.net/npm/three@0.186.1/build/three.module.js",
                   "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.186.1/examples/jsm/" } }
  </script>
  <script src="<%= asset("js/preview.js") %>"></script>
