<% fv = ->(o, k) { o.respond_to?(k) ? o.public_send(k) : (o.respond_to?(:[]) ? (o[k.to_s].nil? ? o[k] : o[k.to_s]) : nil) } -%>
<% fields = (spec && fv.(spec, :fields)) || [] -%>
<% intro_html = spec && fv.(spec, :intro_html) -%>
<% draft = draft || {} -%>
<% draft_for = ->(id) { draft.key?(id) ? draft[id] : draft[id.to_sym] } -%>
<% input_fields = fields.reject { |f| fv.(f, :type).to_s == "markdown" } -%>
<% form_data = {
     base: base, draft: draft, submissions: submissions.to_i, submitted_at: submitted_at&.respond_to?(:iso8601) ? submitted_at.iso8601 : submitted_at,
     fields: input_fields.map do |f|
       { id: fv.(f, :id).to_s, type: fv.(f, :type).to_s, label: fv.(f, :label).to_s, required: !!fv.(f, :required),
         min: fv.(f, :min), max: fv.(f, :max), max_chars: fv.(f, :max_chars) || text_max_chars, default: fv.(f, :default),
         option_values: (fv.(f, :options) || []).map { |o| fv.(o, :value) } }
     end
   } -%>
<%== render("share_nav", locals: { share: share, base: base, zip_href: zip_href }) %>

  <main class="t-shell-main t-page has-form-bar" id="content">
    <form class="share-form" id="share-form" novalidate autocomplete="off">
      <% if intro_html && !intro_html.to_s.empty? -%>
      <div class="t-card form-intro"><div class="t-card-body md-body"><%== intro_html %></div></div>
      <% end -%>

      <% fields.each_with_index do |f, fi| -%>
      <% id = fv.(f, :id).to_s; type = fv.(f, :type).to_s; value = draft_for.(id) -%>
      <% if type == "markdown" -%>
      <div class="t-card form-field form-field-prose" data-field="<%= id %>" data-type="markdown">
        <div class="t-card-body md-body"><%== fv.(f, :html) %></div>
      </div>
      <% else -%>
      <% required = !!fv.(f, :required); help = fv.(f, :help); min = fv.(f, :min); max = fv.(f, :max) -%>
      <div class="t-card form-field" data-field="<%= id %>" data-type="<%= type %>">
        <div class="t-card-header form-field-header">
          <span class="form-field-label"><%= fv.(f, :label) %><% if required %> <span class="form-required" data-tip="Required">*</span><% end %></span>
          <% if help && !help.to_s.empty? %><span class="t-hint form-field-help"><%= help %></span><% end %>
        </div>
        <div class="t-card-body">
          <% case type when "checklist", "tasklist" -%>
          <% prose = type == "tasklist" && fv.(f, :html) -%>
          <% if prose && !prose.to_s.empty? %><div class="md-body tasklist-prose"><%== prose %></div><% end %>
          <% opts = fv.(f, :options) || []; selected = Array(value).map(&:to_s) -%>
          <% if opts.size >= bulk_threshold.to_i -%>
          <div class="bulk-bar">
            <div class="t-input-group bulk-filter" data-size="sm">
              <span class="t-input-addon"><%== icon("funnel") %></span>
              <input type="search" class="t-input" placeholder="Filter…" aria-label="Filter options" data-filter>
            </div>
            <button type="button" class="t-btn" data-size="sm" data-bulk="all" data-tip="Check every visible row"><%== icon("check2-all") %>Check all</button>
            <button type="button" class="t-btn" data-size="sm" data-bulk="none" data-tip="Uncheck every visible row"><%== icon("x-lg") %>Uncheck all</button>
            <button type="button" class="t-btn" data-size="sm" data-bulk="invert" data-tip="Invert every visible row"><%== icon("arrow-left-right") %>Invert</button>
            <span class="t-badge opt-count" data-tone="accent" data-count><%= selected.size %> of <%= opts.size %> selected</span>
          </div>
          <% end -%>
          <div class="opt-list">
            <% opts.each_with_index do |o, oi| -%>
            <% v = fv.(o, :value); on = selected.include?(v.to_s); hint = fv.(o, :hint); label_html = type == "tasklist" && fv.(o, :label_html) -%>
            <label class="t-check opt-row" for="opt-<%= fi %>-<%= oi %>"<%== ' aria-selected="true"' if on %> data-text="<%= [fv.(o, :label), hint].compact.join(' ').downcase %>">
              <input class="t-check-input" type="checkbox" id="opt-<%= fi %>-<%= oi %>" name="<%= id %>" value="<%= v %>"<%= ' checked' if on %>>
              <span class="t-check-label"><% if label_html && !label_html.to_s.empty? %><%== label_html %><% else %><%= fv.(o, :label) %><% end %><% if hint && !hint.to_s.empty? %><span class="t-check-desc opt-hint"><%= hint %></span><% end %></span>
            </label>
            <% end -%>
            <div class="opt-none t-muted t-small" hidden>No option matches the filter.</div>
          </div>
          <% if min || max -%>
          <p class="t-hint opt-limits" data-limits><% if min && max %>Pick <%= min == max ? min : "#{min} to #{max}" %><% elsif min %>Pick at least <%= min %><% else %>Pick at most <%= max %><% end %>.</p>
          <% end -%>
          <% when "radio" -%>
          <div class="opt-list">
            <% (fv.(f, :options) || []).each_with_index do |o, oi| -%>
            <% v = fv.(o, :value); on = value.to_s == v.to_s && !value.nil?; hint = fv.(o, :hint) -%>
            <label class="t-check opt-row" for="opt-<%= fi %>-<%= oi %>"<%== ' aria-selected="true"' if on %>>
              <input class="t-check-input" type="radio" id="opt-<%= fi %>-<%= oi %>" name="<%= id %>" value="<%= v %>"<%= ' checked' if on %>>
              <span class="t-check-label"><%= fv.(o, :label) %><% if hint && !hint.to_s.empty? %><span class="t-check-desc opt-hint"><%= hint %></span><% end %></span>
            </label>
            <% end -%>
          </div>
          <% when "select" -%>
          <select class="t-select" name="<%= id %>" id="field-<%= fi %>">
            <option value=""<%= ' selected' if value.nil? || value.to_s.empty? %>>— choose —</option>
            <% (fv.(f, :options) || []).each do |o| -%>
            <% v = fv.(o, :value); hint = fv.(o, :hint) -%>
            <option value="<%= v %>"<%= ' selected' if !value.nil? && value.to_s == v.to_s %>><%= fv.(o, :label) %><% if hint && !hint.to_s.empty? %> — <%= hint %><% end %></option>
            <% end -%>
          </select>
          <% when "text" -%>
          <% limit = fv.(f, :max_chars) || text_max_chars; placeholder = fv.(f, :placeholder) -%>
          <% if fv.(f, :multiline) -%>
          <textarea class="t-textarea" name="<%= id %>" id="field-<%= fi %>" rows="4" maxlength="<%= limit %>" placeholder="<%= placeholder %>"><%= value %></textarea>
          <% else -%>
          <input type="text" class="t-input" name="<%= id %>" id="field-<%= fi %>" maxlength="<%= limit %>" placeholder="<%= placeholder %>" value="<%= value %>">
          <% end -%>
          <p class="t-hint char-count" data-char-count data-max="<%= limit %>"><%= value.to_s.length %> / <%= limit %></p>
          <% end -%>
          <p class="t-feedback form-error" data-tone="danger" data-error-for="<%= id %>"></p>
        </div>
      </div>
      <% end -%>
      <% end -%>

      <% if fields.empty? -%>
      <div class="t-empty"><%== icon("ui-checks", css: "t-empty-icon") %>This form has no fields.</div>
      <% end -%>
    </form>

    <% unless items.nil? || items.empty? -%>
    <div class="section-label files-label">Files</div>
<%== render("file_table", locals: { rows: items }) %>
    <% end -%>

    <div class="form-bar" id="form-bar">
      <div class="form-bar-status">
        <span class="form-status" id="bar-progress" data-tip="Fields answered"><%== icon("list-check") %> <span>…</span></span>
        <span class="form-status" id="bar-draft" data-state="saved" data-tip="Draft autosave"><%== icon("cloud-check") %> <span>Saved</span></span>
        <span class="form-status" id="bar-submit" data-tip="Submission state"><%== icon("send") %> <span>Not submitted yet</span></span>
      </div>
      <div class="form-bar-actions">
        <button type="button" class="t-btn serve-action" data-dialog-open="reset-modal" data-tip="Restore the defaults"><%== icon("arrow-counterclockwise") %>Reset</button>
        <button type="button" class="t-btn serve-action" data-variant="primary" id="submit-btn"><%== icon("send") %>Submit</button>
      </div>
    </div>
  </main>

  <dialog class="t-dialog" id="reset-modal" data-tone="danger" aria-labelledby="reset-modal-title">
    <div class="t-dialog-header"><h2 class="t-dialog-title" id="reset-modal-title"><%== icon("arrow-counterclockwise") %><span>Reset the form?</span></h2><button class="t-dialog-close" type="button" aria-label="Close" data-dialog-close>×</button></div>
    <div class="t-dialog-body">Every field goes back to its default and the draft is saved that way. Earlier submissions are kept.</div>
    <div class="t-dialog-footer"><button class="t-btn" type="button" data-dialog-close>Cancel</button><button class="t-btn" data-variant="danger" type="button" id="reset-confirm">Reset</button></div>
  </dialog>

<%== render("preview_modal") %>
<%== render("stop_modal", locals: { base: base }) %>

  <script type="application/json" id="form-data"><%== JSON.generate(form_data).gsub("<", "\\u003c") %></script>
  <script type="module" src="<%= asset("js/form.js") %>"></script>
