<div data-slot="tools">
  <button class="t-btn" data-size="sm" data-icon="only" type="button" data-role="expand" data-tip="Expand all folders" aria-label="Expand all folders" hidden><%== icon("arrows-expand") %></button>
  <button class="t-btn" data-size="sm" data-icon="only" type="button" data-role="collapse" data-tip="Collapse all folders" aria-label="Collapse all folders" hidden><%== icon("arrows-collapse") %></button>
</div>
<div data-slot="body">
  <div class="preview-panel preview-archive">
    <div class="preview-overlay" data-role="loading"><span class="t-spinner" role="status" aria-label="Loading"></span><span>Reading the archive…</span></div>
    <div class="file-view-notice" data-role="notice" hidden><%== icon("info-circle") %><span data-role="notice-text"></span></div>
    <div class="archive-body" data-role="body">
      <table class="t-table archive-table" hidden data-role="table">
        <thead><tr><th>Name</th><th class="t-col-num">Size</th><th class="archive-date">Modified</th></tr></thead>
        <tbody data-role="rows"></tbody>
      </table>
    </div>
  </div>
</div>
