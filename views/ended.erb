<% fmt_time = ->(t) { t.respond_to?(:strftime) ? t.strftime('%Y-%m-%d %H:%M') : t.to_s } -%>
<% rv = ->(h, k) { h.respond_to?(:key?) ? (h.key?(k.to_s) ? h[k.to_s] : h[k.to_sym]) : (h.respond_to?(k) ? h.public_send(k) : nil) } -%>
<% tally = result[:files] || {} -%>
<% count = result[:downloads].to_i -%>
<% answers = rv.(result, :answers); draft = rv.(result, :draft); form = rv.(result, :form) -%>
<% form_fields = (form && rv.(form, :fields)) || [] -%>
<% submissions = rv.(result, :submissions).to_i; submitted_at = rv.(result, :submitted_at) -%>
<% answer_rows = ->(values) {
     labelled = form_fields.reject { |f| rv.(f, :type).to_s == "markdown" }.map { |f| [rv.(f, :id).to_s, f] }
     extra = (values || {}).keys.map(&:to_s) - labelled.map(&:first)
     (labelled + extra.map { |k| [k, nil] }).map do |id, f|
       names = ((f && rv.(f, :options)) || []).to_h { |o| [rv.(o, :value).to_s, rv.(o, :label).to_s] }
       v = rv.(values || {}, id)
       shown = Array(v).map { |x| names.fetch(x.to_s, x.to_s) }.reject(&:empty?)
       [f ? rv.(f, :label).to_s : id, shown]
     end
   } -%>
  <header class="t-navbar t-shell-nav">
    <span class="t-navbar-brand"><%== icon("cloud-arrow-down") %><%= result[:title] || share.title %></span>
  </header>

  <main class="t-shell-main t-page">
    <div class="notice-panel">
      <%== icon("stop-circle", css: "notice-icon notice-ended") %>
      <h1 class="notice-title">This share has ended</h1>
      <p class="t-muted notice-reason"><%= result[:reason] %><% if result[:duration] %> · after <%= result[:duration] %><% end %></p>

      <div class="t-card"><div class="t-card-body">
        <dl class="notice-facts">
          <dt>Started</dt><dd><%= fmt_time.(result[:started_at]) %></dd>
          <dt>Ended</dt><dd><%= fmt_time.(result[:ended_at]) %></dd>
          <dt>Downloads</dt><dd><%= count %> download<%= 's' unless count == 1 %></dd>
        </dl>
      </div></div>

      <% unless tally.empty? -%>
      <div class="section-label">Downloaded</div>
      <div class="t-card"><div class="t-card-body">
        <ul class="download-list">
          <% tally.each do |name, n| -%>
          <li><%== icon("download", css: "kind-file") %><span class="file-name"><%= name %></span><% if n.to_i > 1 %><span class="download-count">×<%= n %></span><% end %></li>
          <% end -%>
        </ul>
      </div></div>
      <% end -%>

      <% if answers -%>
      <div class="section-label">Answers</div>
      <div class="t-card">
        <div class="t-card-body">
          <table class="t-table answers-table">
            <tbody>
            <% answer_rows.(answers).each do |label, shown| -%>
            <tr><th scope="row"><%= label %></th><td><% if shown.empty? %><span class="answer-empty">—</span><% else %><%= shown.join(', ') %><% end %></td></tr>
            <% end -%>
            </tbody>
          </table>
        </div>
        <% if submissions.positive? -%>
        <div class="t-card-footer t-muted t-small"><%== icon("send") %> Submitted <%= submissions %> time<%= 's' unless submissions == 1 %><% if submitted_at %>, last at <%= fmt_time.(submitted_at) %><% end %></div>
        <% end -%>
      </div>
      <% end -%>

      <% if draft && !draft.empty? -%>
      <div class="section-label">Unsubmitted draft</div>
      <div class="t-card"><div class="t-card-body">
        <p class="t-muted t-small draft-note"><%== icon("pencil") %> Changed after the last submit, never submitted.</p>
        <table class="t-table answers-table answers-draft">
          <tbody>
          <% answer_rows.(draft).each do |label, shown| -%>
          <tr><th scope="row"><%= label %></th><td><% if shown.empty? %><span class="answer-empty">—</span><% else %><%= shown.join(', ') %><% end %></td></tr>
          <% end -%>
          </tbody>
        </table>
      </div></div>
      <% end -%>

      <p class="t-muted t-small notice-close">You can close this tab.</p>
    </div>
  </main>
