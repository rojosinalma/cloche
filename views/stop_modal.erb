  <dialog class="t-dialog" id="stop-modal" data-tone="danger" aria-labelledby="stop-modal-title">
    <div class="t-dialog-header"><h2 class="t-dialog-title" id="stop-modal-title"><i class="t-icon bi bi-stop-circle" aria-hidden="true"></i><span>Stop serving?</span></h2><button class="t-dialog-close" type="button" aria-label="Close" data-dialog-close>×</button></div>
    <div class="t-dialog-body">The links on this page stop working and the agent that served them is told you ended it.</div>
    <div class="t-dialog-footer"><button class="t-btn" type="button" data-dialog-close>Cancel</button><button class="t-btn" data-variant="danger" type="button" id="stop-confirm" data-stop-url="<%= base %>/stop" onclick="stopServing()">Stop serving</button></div>
  </dialog>

  <script>
    async function stopServing() {
      const btn = document.getElementById('stop-confirm');
      btn.disabled = true; btn.innerHTML = '<span class="t-spinner" data-size="sm" role="status"></span>';
      try {
        const res = await fetch(btn.dataset.stopUrl, { method: 'POST', headers: { 'Accept': 'application/json' } });
        const r = await res.json();
        if (!r.ok) throw new Error(r.message || `HTTP ${res.status}`);
        document.getElementById('stop-modal').close();
        document.querySelectorAll('.serve-action').forEach(b => b.remove());
        document.getElementById('content').innerHTML =
          '<div class="t-empty"><i class="t-icon t-empty-icon bi bi-stop-circle"></i>Serving stopped. You can close this tab.</div>';
        toast('success', r.message);
      } catch (e) {
        btn.disabled = false; btn.textContent = 'Stop serving';
        toast('error', `Could not stop: ${e.message}`);
      }
    }
  </script>
