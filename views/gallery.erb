<% items = media + files -%>
<%== render("share_nav", locals: { share: share, base: base, zip_href: items.empty? ? nil : zip_href }) %>

  <main class="t-shell-main t-page" id="content">
    <% unless crumbs.empty? -%>
    <nav class="t-breadcrumb crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="<%= base %>/" aria-label="Share root"><i class="bi bi-house-door"></i></a></li>
        <% crumbs.each_with_index do |(label, link), i| -%>
        <% if i == crumbs.size - 1 %><li aria-current="page"><%= label %></li><% else %><li><a href="<%= link %>"><%= label %></a></li><% end %>
        <% end -%>
      </ol>
    </nav>
    <% end -%>

    <% if items.empty? -%>
    <div class="t-empty"><i class="t-icon t-empty-icon bi bi-inbox"></i>This folder is empty.</div>
    <% else -%>
    <p class="t-muted t-small item-count"><%= items.size %> item<%= 's' unless items.size == 1 %><% if total_size.positive? %> · <%= Listing.human_size(total_size) %><% end %></p>
    <% end -%>

    <% unless media.empty? -%>
    <div class="section-label">Previews</div>
    <div class="t-grid media-grid" data-min="xs">
      <% media.each do |m| -%>
      <div class="t-card media-card" data-variant="thumb">
        <% if m.kind == :audio -%>
        <div class="t-card-thumb"><audio src="<%= m.preview_src %>" controls preload="none"></audio></div>
        <% else -%>
        <a href="<%= m.view_href %>" class="t-card-thumb preview-link" title="Open preview" <%== preview_attrs(m) %>>
          <% if m.kind == :image -%>
          <img src="<%= m.preview_src %>" alt="<%= m.name %>" loading="lazy">
          <% else -%>
          <video src="<%= m.preview_src %>" preload="metadata" muted playsinline tabindex="-1"></video>
          <span class="media-play"><i class="bi bi-play-circle-fill"></i></span>
          <% end -%>
        </a>
        <% end -%>
        <div class="t-card-meta">
          <a class="file-name" href="<%= m.view_href %>" title="Open preview" <%== preview_attrs(m) %>><%= m.name %></a>
          <span class="file-size"><%= Listing.human_size(m.size) %></span>
          <a class="t-btn" data-size="sm" data-icon="only" data-tone="success" href="<%= m.href %>" title="Download" aria-label="Download"><i class="t-icon bi bi-download"></i></a>
        </div>
      </div>
      <% end -%>
    </div>
    <% end -%>

    <% unless files.empty? -%>
    <% unless media.empty? %><div class="section-label">Files</div><% end %>
<%== render("file_table", locals: { rows: files }) %>
    <% end -%>
  </main>

<%== render("preview_modal") %>
<%== render("stop_modal", locals: { base: base }) %>
