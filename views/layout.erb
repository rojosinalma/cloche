<% page_title = (defined?(title) && title) || "cloche" -%>
<% footer_idle = defined?(idle_label) && idle_label -%>
<% footer_expires = defined?(expires_at) && expires_at -%>
<% footer_permanent = defined?(permanent) && permanent -%>
<% footer_status = defined?(status_url) && status_url -%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page_title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="<%= asset("css/dracula.css") %>" rel="stylesheet">
  <link href="<%= asset("css/app.css") %>" rel="stylesheet">
  <script>
    (function() {
      var t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body>
<%== yield %>

  <div id="toast-container"></div>

  <footer class="app-footer">
    <div class="footer-right">
      <span class="footer-version">cloche<% if footer_permanent %> · <span id="expiry" data-permanent="1" data-status-url="<%= footer_status %>" title="This share stays up until it is stopped"><i class="bi bi-infinity"></i> <span id="expiry-left">until stopped</span></span><% else %><% if footer_idle %> · stops after <%= footer_idle %> idle<% end %><% if footer_expires %> · <span id="expiry" data-expires-at="<%= footer_expires %>" data-status-url="<%= footer_status %>" title="Time left before this share ends if nobody touches it"><i class="bi bi-hourglass-split"></i> <span id="expiry-left">--:--</span></span><% end %><% end %></span>
      <button class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode"><i class="bi bi-sun-fill theme-icon-light"></i><i class="bi bi-moon-fill theme-icon-dark"></i></button>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleTheme() {
      const t = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t); localStorage.setItem('theme', t);
    }
    function toast(type, msg) {
      const icons = { success: 'check-circle-fill', warning: 'exclamation-triangle-fill', error: 'x-circle-fill' };
      const el = document.createElement('div');
      el.className = `toast-item toast-${type}`;
      el.innerHTML = `<i class="bi bi-${icons[type] || icons.error}"></i><span></span>`;
      el.querySelector('span').textContent = msg;
      document.getElementById('toast-container').appendChild(el);
      setTimeout(() => { el.classList.add('leaving'); setTimeout(() => el.remove(), 300); }, 2500);
    }
    (function expiryTimer() {
      const el = document.getElementById('expiry');
      if (!el) return;
      let expiresAt = Number(el.dataset.expiresAt || 0) * 1000;
      let permanent = !!el.dataset.permanent;
      let ended = false;
      const left = document.getElementById('expiry-left');
      const icon = el.querySelector('i');
      const fmt = (s) => {
        const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
        return (h ? `${h}:${String(m).padStart(2, '0')}` : m) + ':' + String(sec).padStart(2, '0');
      };
      const markEnded = (reason) => {
        if (ended) return;
        ended = true;
        left.textContent = 'ended';
        document.querySelectorAll('.serve-action').forEach(b => b.remove());
        const content = document.getElementById('content');
        if (content) content.innerHTML = `<div class="empty-state"><i class="bi bi-hourglass-bottom"></i>This share has ended (${reason}). You can close this tab.</div>`;
        toast('warning', `Share ended: ${reason}`);
      };
      const setPermanent = (on) => {
        permanent = on;
        icon.className = on ? 'bi bi-infinity' : 'bi bi-hourglass-split';
        el.title = on ? 'This share stays up until it is stopped' : 'Time left before this share ends if nobody touches it';
        if (on) { left.textContent = 'until stopped'; el.classList.remove('text-warning'); }
      };
      const sync = async () => {
        try {
          const r = await (await fetch(el.dataset.statusUrl, { headers: { 'Accept': 'application/json' } })).json();
          if (!r.live) return markEnded(r.reason || 'stopped');
          if (!!r.permanent !== permanent) setPermanent(!!r.permanent);
          if (!r.permanent) expiresAt = new Date(r.expires_at).getTime();
          el.classList.toggle('in-flight', !!r.in_flight);
        } catch (e) { /* keep counting locally */ }
      };
      const tick = () => {
        if (ended || permanent) return;
        const s = Math.max(0, Math.round((expiresAt - Date.now()) / 1000));
        left.textContent = fmt(s);
        el.classList.toggle('text-warning', s > 0 && s <= 300);
        if (s === 0) sync();
      };
      tick();
      setInterval(tick, 1000);
      setInterval(sync, 30000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) sync(); });
    })();
  </script>
</body>
</html>
