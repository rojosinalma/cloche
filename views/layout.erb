<% page_title = (defined?(title) && title) || "cloche" -%>
<% footer_idle = defined?(idle_label) && idle_label -%>
<% footer_expires = defined?(expires_at) && expires_at -%>
<% footer_permanent = defined?(permanent) && permanent -%>
<% footer_status = defined?(status_url) && status_url -%>
<% footer_external = defined?(external) && external -%>
<% tip_permanent = footer_external ? "This link works until it is revoked" : "This share stays up until it is stopped" -%>
<% tip_expiring = footer_external ? "Time left before this link expires" : "Time left before this share ends if nobody touches it" -%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page_title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <%# tailor head (vendored public/tailor/tailor-head.html, kept current by `tailor sync`) %>
  <%== File.read(File.join(opts[:root] || Dir.pwd, "public/tailor/tailor-head.html")) %>
  <link href="<%= asset("css/app.css") %>" rel="stylesheet">
  <script>
    // toast() is called by page scripts that may run before tailor.js is up: queue until then.
    function toast(type, msg) {
      if (window.Tailor) return Tailor.toast(type === 'error' ? 'danger' : type, msg);
      document.addEventListener('DOMContentLoaded', () => toast(type, msg), { once: true });
    }
  </script>
</head>
<body>
<div class="t-shell">
<%== yield %>

  <footer class="t-footer t-shell-foot">
    <div class="t-footer-end">
      <div data-tailor-pickers></div>
      <span class="t-footer-version">cloche<% if footer_permanent %> · <span id="expiry" data-permanent="1" data-status-url="<%= footer_status %>" data-tip="<%= tip_permanent %>" data-tip-permanent="<%= tip_permanent %>" data-tip-expiring="<%= tip_expiring %>"><%== icon("infinity") %> <span id="expiry-left"><%= footer_external ? "until revoked" : "until stopped" %></span></span><% else %><% if footer_idle %> · stops after <%= footer_idle %> idle<% end %><% if footer_expires %> · <span id="expiry" data-expires-at="<%= footer_expires %>" data-status-url="<%= footer_status %>" data-tip="<%= tip_expiring %>" data-tip-permanent="<%= tip_permanent %>" data-tip-expiring="<%= tip_expiring %>"><%== icon("hourglass-split") %> <span id="expiry-left">--:--</span></span><% end %><% end %></span>
    </div>
  </footer>
</div>

<%# Tailor.toast appends .t-toast here %>
<div id="t-toasts" class="t-toasts" aria-live="polite" aria-atomic="false"></div>

  <script>
    (function expiryTimer() {
      const el = document.getElementById('expiry');
      if (!el) return;
      let expiresAt = Number(el.dataset.expiresAt || 0) * 1000;
      let permanent = !!el.dataset.permanent;
      let ended = false;
      const left = document.getElementById('expiry-left');
      const iconUse = el.querySelector('use');
      const fmt = (s) => {
        const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
        return (h ? `${h}:${String(m).padStart(2, '0')}` : m) + ':' + String(sec).padStart(2, '0');
      };
      const markEnded = (reason) => {
        if (ended) return;
        ended = true;
        left.textContent = 'ended';
        document.querySelectorAll('.serve-action').forEach(b => b.remove());
        const content = document.getElementById('content');
        if (content) content.innerHTML = `<div class="t-empty"><%== icon("hourglass-bottom", css: "t-empty-icon") %>This <%= footer_external ? "link" : "share" %> has ended (${reason}). You can close this tab.</div>`;
        toast('warning', `<%= footer_external ? "Link" : "Share" %> ended: ${reason}`);
      };
      const setPermanent = (on) => {
        permanent = on;
        iconUse.setAttribute('href', `/tailor/icons.svg#bi-${on ? 'infinity' : 'hourglass-split'}`);
        el.dataset.tip = on ? el.dataset.tipPermanent : el.dataset.tipExpiring;
        if (on) { left.textContent = '<%= footer_external ? "until revoked" : "until stopped" %>'; delete el.dataset.soon; }
      };
      const sync = async () => {
        try {
          const r = await (await fetch(el.dataset.statusUrl, { headers: { 'Accept': 'application/json' } })).json();
          if (!r.live) return markEnded(r.reason || 'stopped');
          if (!!r.permanent !== permanent) setPermanent(!!r.permanent);
          if (!r.permanent) expiresAt = new Date(r.expires_at).getTime();
          el.classList.toggle('in-flight', !!r.in_flight);
        } catch (e) { /* keep counting locally */ }
      };
      const tick = () => {
        if (ended || permanent) return;
        const s = Math.max(0, Math.round((expiresAt - Date.now()) / 1000));
        left.textContent = fmt(s);
        if (s > 0 && s <= 300) el.dataset.soon = ''; else delete el.dataset.soon;
        if (s === 0) sync();
      };
      tick();
      setInterval(tick, 1000);
      setInterval(sync, 30000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) sync(); });
    })();
  </script>
</body>
</html>
