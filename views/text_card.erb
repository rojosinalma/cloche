<div class="text-card" data-label="<%= view.label %>" data-lines="<%= view.lines.to_i %>" data-pretty="<%= view.pretty? ? 1 : 0 %>" data-copy="<%= view.too_large? || view.empty? ? 0 : 1 %>">
  <% view.notices.each do |notice| -%>
  <div class="file-view-notice"><i class="t-icon bi bi-info-circle"></i><%= notice %></div>
  <% end -%>
  <div class="file-view-body">
    <% if view.too_large? -%>
    <div class="t-empty">
      <i class="t-icon t-empty-icon bi bi-file-earmark-x"></i>
      This file is <%= Listing.human_size(view.size) %>, above the <%= Listing.human_size(view.max_bytes) %> viewer limit.
      <div class="t-empty-actions"><a class="t-btn" data-variant="primary" href="<%= download_href %>"><i class="t-icon bi bi-download"></i>Download it instead</a></div>
    </div>
    <% elsif view.empty? -%>
    <div class="t-empty"><i class="t-icon t-empty-icon bi bi-file-earmark"></i>This file is empty.</div>
    <% else -%>
    <% if view.pretty? -%>
    <div class="view-pane" data-pane="pretty"><%== view.pretty_html %></div>
    <% end -%>
    <div class="view-pane code-lines hl" data-pane="source"<%== ' hidden' if view.pretty? %>><%== view.source_html %></div>
    <% end -%>
  </div>
</div>
